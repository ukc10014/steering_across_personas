maniprobe/

# Claude Code local state / worktrees.
# Note the glob rather than `.claude/`: a trailing-slash rule excludes the directory
# itself, so git never descends into it and a `!` re-include below would silently do
# nothing. `.claude/*` ignores the contents while still allowing exceptions.
.claude/*
# Shared, reviewable permission allowlist -- portable across machines and clones.
!.claude/settings.json

# ICML LaTeX: compiled output and template boilerplate (keep .sty/.bst/main.tex/references.bib)
icml2026/main.pdf
icml2026/example_paper.*

# ICLR LaTeX: same convention as icml2026 above
iclr2026/main.pdf
icml2026/icml_numpapers.pdf

# Stray screenshots
Screenshot*.png
